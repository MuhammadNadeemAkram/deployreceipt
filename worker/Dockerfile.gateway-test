FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends iptables util-linux && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm install --global npm@12.2.1 && npm ci --ignore-scripts
COPY worker/gateway ./worker/gateway
COPY worker/security.ts ./worker/security.ts
COPY tests/integration/gateway-transport.ts tests/integration/gateway-transport-entrypoint.sh ./tests/integration/
RUN chmod 755 tests/integration/gateway-transport-entrypoint.sh
ENTRYPOINT ["/app/tests/integration/gateway-transport-entrypoint.sh"]
