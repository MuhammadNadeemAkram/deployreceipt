NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use only the Supabase publishable key (sb_publishable_...), never a secret key.
# No service-role key or database password is used by this application.
# Apply migrations via the Supabase CLI with your own secure CLI login.

# Scanning has no public-mode environment switch. Configure scan_settings server-side.
# Worker-only secrets belong in the ignored .env.worker; see .env.worker.example.

# PDF export validates request Origin against NEXT_PUBLIC_SITE_URL.
# No PDF service secret or external rendering endpoint is required.
