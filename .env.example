# Credential-free local configuration. No worker secrets belong in this file.
APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SCANNING_AVAILABLE=disabled
OPERATIONAL_LOGS=enabled
# Optional local-only legacy signup. Never accepted in hosted/production builds.
LOCAL_PUBLIC_SIGNUP=
# Set both distinct refs on hosted deployments; never point a preview at production.
STAGING_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
PRODUCTION_ACTIVATION=
